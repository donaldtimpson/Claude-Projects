  "items": [
    { "id": "l04-find-01", "level": 1, "prompt": "Which word is the adjective?\n\n“The red ball bounced.”", "options": ["The", "red", "ball", "bounced"], "answer": 1, "explain": "“red” describes the noun “ball” — it is the adjective." },
    { "id": "l04-find-02", "level": 1, "prompt": "Which word is the adjective?\n\n“A brave soldier marched.”", "options": ["brave", "soldier", "marched"], "answer": 0, "explain": "“brave” describes the soldier." },
    { "id": "l04-find-03", "level": 1, "prompt": "Which word is the adjective?\n\n“She wore a silk dress.”", "options": ["wore", "silk", "dress"], "answer": 1, "explain": "“silk” describes the dress." },
    { "id": "l04-find-04", "level": 1, "prompt": "Which word is the adjective?\n\n“Three cats napped.”", "options": ["Three", "cats", "napped"], "answer": 0, "explain": "“Three” tells how many — a (definitive) adjective." },
    { "id": "l04-find-05", "level": 1, "prompt": "Which word is the adjective?\n\n“He told a funny story.”", "options": ["told", "funny", "story"], "answer": 1, "explain": "“funny” describes the story." },
    { "id": "l04-find-06", "level": 1, "prompt": "Which word is the adjective?\n\n“Cold water refreshes.”", "options": ["Cold", "water", "refreshes"], "answer": 0, "explain": "“Cold” describes the water." },
    { "id": "l04-find-07", "level": 1, "prompt": "Which word is the adjective?\n\n“The tall tree swayed.”", "options": ["The", "tall", "tree", "swayed"], "answer": 1, "explain": "“tall” describes the tree." },
    { "id": "l04-find-08", "level": 1, "prompt": "Which word is the adjective?\n\n“A wise owl watched.”", "options": ["wise", "owl", "watched"], "answer": 0, "explain": "“wise” describes the owl." },

    { "id": "l04-dd-01", "level": 1, "prompt": "Descriptive or definitive adjective?\n\nripe", "options": ["Descriptive", "Definitive"], "answer": 0, "explain": "“ripe” names a quality, so it is descriptive." },
    { "id": "l04-dd-02", "level": 1, "prompt": "Descriptive or definitive adjective?\n\nfour", "options": ["Descriptive", "Definitive"], "answer": 1, "explain": "“four” counts, giving no quality, so it is definitive." },
    { "id": "l04-dd-03", "level": 1, "prompt": "Descriptive or definitive adjective?\n\ngolden", "options": ["Descriptive", "Definitive"], "answer": 0, "explain": "“golden” names a quality — descriptive." },
    { "id": "l04-dd-04", "level": 1, "prompt": "Descriptive or definitive adjective?\n\nthose", "options": ["Descriptive", "Definitive"], "answer": 1, "explain": "“those” points out without a quality — definitive." },
    { "id": "l04-dd-05", "level": 1, "prompt": "Descriptive or definitive adjective?\n\ngentle", "options": ["Descriptive", "Definitive"], "answer": 0, "explain": "“gentle” names a quality — descriptive." },
    { "id": "l04-dd-06", "level": 1, "prompt": "Descriptive or definitive adjective?\n\nmany", "options": ["Descriptive", "Definitive"], "answer": 1, "explain": "“many” tells amount without a quality — definitive." },
    { "id": "l04-dd-07", "level": 1, "prompt": "Descriptive or definitive adjective?\n\ncheerful", "options": ["Descriptive", "Definitive"], "answer": 0, "explain": "“cheerful” names a quality — descriptive." },
    { "id": "l04-dd-08", "level": 1, "prompt": "Descriptive or definitive adjective?\n\neach", "options": ["Descriptive", "Definitive"], "answer": 1, "explain": "“each” points out without a quality — definitive." },

    { "id": "l04-an-01", "level": 1, "prompt": "Choose a or an:\n\n___ apple", "options": ["a", "an"], "answer": 1, "explain": "“apple” begins with a vowel sound → an." },
    { "id": "l04-an-02", "level": 1, "prompt": "Choose a or an:\n\n___ dog", "options": ["a", "an"], "answer": 0, "explain": "“dog” begins with a consonant sound → a." },
    { "id": "l04-an-03", "level": 1, "prompt": "Choose a or an:\n\n___ hour", "options": ["a", "an"], "answer": 1, "explain": "The h is silent, so “hour” begins with a vowel sound → an." },
    { "id": "l04-an-04", "level": 1, "prompt": "Choose a or an:\n\n___ house", "options": ["a", "an"], "answer": 0, "explain": "The h is sounded → a house." },
    { "id": "l04-an-05", "level": 1, "prompt": "Choose a or an:\n\n___ honest judge", "options": ["a", "an"], "answer": 1, "explain": "The h is silent → an honest judge." },
    { "id": "l04-an-06", "level": 1, "prompt": "Choose a or an:\n\n___ unicorn", "options": ["a", "an"], "answer": 0, "explain": "“unicorn” starts with a “yoo” (consonant) sound → a." },
    { "id": "l04-an-07", "level": 1, "prompt": "Choose a or an:\n\n___ umbrella", "options": ["a", "an"], "answer": 1, "explain": "“umbrella” begins with a vowel sound → an." },
    { "id": "l04-an-08", "level": 1, "prompt": "Choose a or an:\n\n___ university", "options": ["a", "an"], "answer": 0, "explain": "“university” starts with a “yoo” sound → a." },
    { "id": "l04-an-09", "level": 1, "prompt": "Choose a or an:\n\n___ egg", "options": ["a", "an"], "answer": 1, "explain": "“egg” begins with a vowel sound → an." },
    { "id": "l04-an-10", "level": 1, "prompt": "Choose a or an:\n\n___ elephant", "options": ["a", "an"], "answer": 1, "explain": "“elephant” begins with a vowel sound → an." },

    { "id": "l04-fix-01", "level": 1, "prompt": "Which is correct?", "options": ["a apple", "an apple"], "answer": 1, "explain": "Vowel sound → an apple." },
    { "id": "l04-fix-02", "level": 1, "prompt": "Which is correct?", "options": ["these kind of shoe", "this kind of shoe"], "answer": 1, "explain": "Singular noun “kind” → this, not these." },
    { "id": "l04-fix-03", "level": 1, "prompt": "Which is correct?", "options": ["them apples", "those apples"], "answer": 1, "explain": "Use “those,” never “them,” before a noun." },
    { "id": "l04-fix-04", "level": 1, "prompt": "Which is correct?", "options": ["more taller", "taller"], "answer": 1, "explain": "Never double a comparison — just “taller.”" },
    { "id": "l04-fix-05", "level": 1, "prompt": "Which is correct?", "options": ["the most kindest", "the kindest"], "answer": 1, "explain": "Never double a superlative — just “kindest.”" },
    { "id": "l04-fix-06", "level": 1, "prompt": "Which is correct?", "options": ["a hour", "an hour"], "answer": 1, "explain": "Silent h, vowel sound → an hour." },

    { "id": "l04-pt-01", "level": 1, "prompt": "Which participle is it — present, perfect, or compound?\n\n“The laughing child ran off.”", "options": ["Present", "Perfect", "Compound"], "answer": 0, "explain": "“laughing” ends in -ing and shows action going on — present." },
    { "id": "l04-pt-02", "level": 1, "prompt": "Which participle is it — present, perfect, or compound?\n\n“The broken vase lay there.”", "options": ["Present", "Perfect", "Compound"], "answer": 1, "explain": "“broken” shows completed action — perfect." },
    { "id": "l04-pt-03", "level": 1, "prompt": "Which participle is it — present, perfect, or compound?\n\n“Having finished, she left.”", "options": ["Present", "Perfect", "Compound"], "answer": 2, "explain": "“Having finished” uses “having” — compound." },
    { "id": "l04-pt-04", "level": 1, "prompt": "Which participle is it — present, perfect, or compound?\n\n“the twinkling stars”", "options": ["Present", "Perfect", "Compound"], "answer": 0, "explain": "“twinkling” ends in -ing, action going on — present." },
    { "id": "l04-pt-05", "level": 1, "prompt": "Which participle is it — present, perfect, or compound?\n\n“a written note”", "options": ["Present", "Perfect", "Compound"], "answer": 1, "explain": "“written” shows completed action — perfect." },
    { "id": "l04-pt-06", "level": 1, "prompt": "Which participle is it — present, perfect, or compound?\n\n“Having eaten, they rested.”", "options": ["Present", "Perfect", "Compound"], "answer": 2, "explain": "“Having eaten” uses “having” — compound." },

    { "id": "l04-pn-01", "level": 1, "prompt": "Is the -ing word a participle or a participial noun?\n\n“I enjoy swimming.”", "options": ["Participle", "Participial noun"], "answer": 1, "explain": "“swimming” names an action (the thing enjoyed) — a participial noun." },
    { "id": "l04-pn-02", "level": 1, "prompt": "Is the -ing word a participle or a participial noun?\n\n“The swimming fish darted.”", "options": ["Participle", "Participial noun"], "answer": 0, "explain": "“swimming” describes the fish — a participle." },
    { "id": "l04-pn-03", "level": 1, "prompt": "Is the -ing word a participle or a participial noun?\n\n“Reading is fun.”", "options": ["Participle", "Participial noun"], "answer": 1, "explain": "“Reading” names an action and is the subject — a participial noun." },
    { "id": "l04-pn-04", "level": 1, "prompt": "Is the -ing word a participle or a participial noun?\n\n“The barking dog woke us.”", "options": ["Participle", "Participial noun"], "answer": 0, "explain": "“barking” describes the dog (the dog barks) — a participle." }
  ]
