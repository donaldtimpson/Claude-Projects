<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow plain-HTTP to localhost/loopback for local dev (the Simulator hits
	     the Mac's `npm run dev`). Production traffic stays HTTPS. This is the
	     Apple-sanctioned local exception (no arbitrary-loads justification). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
